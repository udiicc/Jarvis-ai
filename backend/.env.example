# Copy to backend/.env; this backend-only file is loaded automatically.
# Leave blank for mock mode. Never put the key in frontend VITE_ variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25
OPENAI_MAX_OUTPUT_TOKENS=800
JARVIS_REQUESTS_PER_MINUTE=10
JARVIS_SYSTEM_INSTRUCTION="You are JARVIS, a helpful personal AI assistant. Be natural, concise, and honest. You have no access to files, messaging, calendars, tools, or computer controls. Never claim to have executed actions."
JARVIS_LOG_LEVEL=INFO
JARVIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# auto preserves previous behavior: OpenAI with a key, otherwise mock.
# ollama never calls OpenAI, even when an OpenAI key exists.
AI_PROVIDER=auto
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=120

# Optional local voice tools; no audio service is downloaded/started automatically.
WHISPER_CPP_BIN=whisper-cli
WHISPER_MODEL_PATH="${HOME}/Library/Application Support/Jarvis/ggml-base.bin"
VOICE_TTS_RATE=175
# Empty chooses an installed matching-language voice. Serbian may not be available.
VOICE_TTS_VOICE_EN=
VOICE_TTS_VOICE_SR=
